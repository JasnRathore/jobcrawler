# Select local or remote storage. Remote operations connect directly to Turso.
DB_MODE=local

# Local database file. Used only in local mode and by --sync.
LOCAL_DB_PATH=local.db

# Required when DB_MODE=remote or when using --sync.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

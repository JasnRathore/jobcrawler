# Select local storage or a remote Turso database.
DB_MODE=local

# Local database file. Used only in local mode.
LOCAL_DB_PATH=local.db

# Required when DB_MODE=remote. Remote mode connects directly to Turso.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
